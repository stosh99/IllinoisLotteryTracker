APP_ENV=development
EXPECTED_DATABASE_NAME=illinois_lottery_tracker_dev
DATABASE_URL=postgresql://lottery_dev:YOUR_PASSWORD@localhost:5432/illinois_lottery_tracker_dev
RAW_DATA_DIR=data/raw

# Authentication is deliberately disabled until the production release gate.
AUTH_ENABLED=false
# Required only when AUTH_ENABLED=true:
# PUBLIC_BASE_URL=http://localhost:5173
# GOOGLE_OIDC_CLIENT_ID=example.apps.googleusercontent.com
# GOOGLE_OIDC_CLIENT_SECRET=replace-me
# AUTH_SECRET_KEYS=<43-character unpadded base64url 32-byte key>
# AUTH_TRUSTED_PROXY_HOPS=none
# Public enablement also requires one API worker and an independently reviewed
# TLS reverse-proxy rate-limit/access-log configuration. Never trust a broad
# proxy network merely to make X-Forwarded-For work.
AUTH_SESSION_IDLE_SECONDS=86400
AUTH_SESSION_ABSOLUTE_SECONDS=604800
AUTH_SESSION_TOUCH_SECONDS=300
AUTH_LOGIN_ATTEMPT_SECONDS=600
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_RECENT_LOGIN_SECONDS=600
