[Unit]
Description=Illinois Lottery Tracker — development API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/stosh99/projects/IllinoisLotteryTracker
EnvironmentFile=/home/stosh99/.config/illinois-lottery-tracker/development.env
Environment=PYTHONPATH=/home/stosh99/projects/IllinoisLotteryTracker/src
ExecStart=/home/stosh99/projects/IllinoisLotteryTracker/.venv/bin/uvicorn illinois_lottery_tracker.api:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
