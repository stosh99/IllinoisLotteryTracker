[Unit]
Description=Illinois Lottery Tracker — public production API and site
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=stosh99
WorkingDirectory=/home/stosh99/projects/IllinoisLotteryTracker
Environment=PYTHONPATH=/home/stosh99/projects/IllinoisLotteryTracker/src
ExecStart=/home/stosh99/projects/IllinoisLotteryTracker/.venv/bin/uvicorn illinois_lottery_tracker.api:app --host 127.0.0.1 --port 8766 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
